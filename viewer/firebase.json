{
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "VoxelFlight",
        "supportEmail": "suman.sharma.ug23@nsut.ac.in",
        "authorizedRedirectUris": [
          "https://voxelflight-3d.web.app/__/auth/handler",
          "https://voxelflight-3d.firebaseapp.com/__/auth/handler"
        ]
      }
    }
  },
  "hosting": {
    "public": "dist-firebase",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {"source": "/workspace", "destination": "/", "type": 302},
      {"source": "/validation", "destination": "/#evidence", "type": 302},
      {"source": "/pipeline", "destination": "/#how", "type": 302},
      {"source": "/signed-out", "destination": "/logout", "type": 302},
      {"source": "/signin-with-chatgpt", "destination": "/login", "type": 302},
      {"source": "/signout-with-chatgpt", "destination": "/account", "type": 302}
    ],
    "headers": [
      {"source": "**", "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
        {"key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob: https://*.googleapis.com https://*.firebaseapp.com https://elimination-around-louise-delicious.trycloudflare.com; frame-src 'self' https://*.firebaseapp.com https://*.web.app; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"},
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}
      ]},
      {"source": "/assets/**", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]},
      {"source": "/firebase-auth/**", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
      {"source": "/auth-settings.json", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
      {"source": "/account{,/**}", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
    ]
  },
  "emulators": {"hosting": {"host": "127.0.0.1", "port": 8140}, "ui": {"enabled": false}, "singleProjectMode": true}
}
